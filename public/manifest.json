{
  "manifest_version": 3,

  "name": "ITFin Helper",
  "description": "Project income, work log gaps and team vacations from ITFin at a glance.",
  "version": "1.1",

  "action": {
    "default_popup": "popup.html",
    "default_title": "ITFin Helper"
  },
  "icons": {
    "16": "favicon-16x16.png",
    "32": "favicon-32x32.png",
    "64": "favicon.png"
  },

  "background": {
    "service_worker": "js/background.js"
  },

  "permissions": ["cookies", "storage"],

  "host_permissions": ["https://keenethics.itfin.io/*"]
}
